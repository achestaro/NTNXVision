# ─── Secrets / local-only (NEVER commit) ───────────────────────────
# Private documentation, design notes and lab screenshots: kept on the developer's machine,
# never published (the repository is public).
/docs/
/ignore/
.env
.env.*
*.local
secrets/
credentials.json
*.pem
*.key
*.pfx
*.crt
*.p12
*.cer
*.mobileprovision
*.keychain-db
.npmrc
*.har

# Collected environment data / snapshots (may contain sensitive topology).
# Root-anchored on purpose: an unanchored `data/` or `resources/` would silently
# swallow a real source directory added later under app/ or core/ — and a file that
# vanishes on a fresh clone is the worst kind of portability bug.
/snapshots/
*.snapshot
*.ntnxsnap
*.ntnxmeta.json
/data/
/exports/
# local lab run artifacts & downloads (real IPs / usernames / VM names)
/resources/
# generated sample reports (lab-derived content)
/ignore/report-preview/
*.xlsx
*.pdf
*.docx
*.zip
# keep template docx files and binary test fixtures of any type
!core/templates/**/*.docx
!core/tests/fixtures/**

# ─── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/dist/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.spec.bak

# ─── Node / Electron ───────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
app/dist/
app/out/
app/.vite/
release/
*.log
npm-debug.log*
yarn-error.log*

# ─── PyInstaller / packaged sidecar output ─────────────────────────
# core/build/ holds the committed spec + entry point; PyInstaller writes its
# intermediate workpath into core/build/<spec name>/ and the frozen result into
# core/dist/. Ignore both, keep the sources.
core/dist/
core/build/ntnxvision-sidecar/
core/build/*.log

# ─── Local tooling / editor / OS ───────────────────────────────────
# agent config: machine-specific settings + reinstallable skill packs
.claude/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
/installers/

# Mission Control Recall (code graph MCP) — machine-specific, do not commit
.mcp.json

# UI screenshots from app/scripts/screenshot.mjs
/app/screenshots/
