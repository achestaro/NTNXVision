<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Electron app's main executable. This is the minimum
  Electron needs: V8's JIT. The app is NOT sandboxed (Developer ID distribution), so no
  network entitlement is needed.

  Not granted here on purpose (SEC-12): disable-library-validation and
  allow-unsigned-executable-memory. They belong only to the PyInstaller sidecar, which is
  re-signed with entitlements.sidecar.plist (build/sign-sidecar.js).

  Keychain: @napi-rs/keyring (keyring-rs) uses the macOS Security framework against the user's login keychain,
  which needs no entitlement outside the App Sandbox. Do not add keychain-access-groups:
  it requires an embedded provisioning profile and makes a Developer-ID build fail to launch.
-->
<plist version="1.0">
  <dict>
    <!-- Required for Electron (V8 JIT) under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
