<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the app and (entitlementsInherit) every helper and the
  bundled PyInstaller sidecar. The app is NOT sandboxed (Developer ID distribution).

  Keychain: keytar uses the legacy SecKeychain APIs against the user's login keychain,
  which needs no entitlement outside the App Sandbox. Do not add keychain-access-groups:
  it requires an embedded provisioning profile and makes a Developer-ID build fail to launch.
-->
<plist version="1.0">
  <dict>
    <!-- Required for Electron (V8 JIT) under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- The PyInstaller sidecar unpacks/loads its own dylibs at runtime. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Outbound HTTPS to Prism Central / Prism Element / NDB (sidecar and renderer). -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
