<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the frozen Python core (Contents/Resources/sidecar),
  applied only to its executable by build/sign-sidecar.js. A PyInstaller one-folder build
  loads its bundled Python runtime and extension modules at run time, and ctypes / libffi
  map executable memory. These two are kept on the sidecar only (SEC-12) and are not
  granted to the Electron app.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
