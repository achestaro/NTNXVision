{
  "name": "ntnxvision",
  "version": "0.7.1",
  "description": "NTNXVision: Nutanix Prism Central inventory & documentation tool",
  "author": "Alberto Chestaro",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && npx concurrently -k -n vite,tsc,electron -c cyan,yellow,green \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "npx vite",
    "dev:main": "npx tsc -p tsconfig.main.json -w",
    "dev:electron": "npx wait-on http://localhost:5273 dist/main/main.js && npx electron .",
    "dev:demo": "npm run build:main && npx concurrently -k -n vite,tsc,electron -c cyan,yellow,green \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron:demo\"",
    "dev:electron:demo": "npx wait-on http://localhost:5273 dist/main/main.js && npx electron . --demo",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "npx vite build",
    "build:main": "npx tsc -p tsconfig.main.json && npm run build:preload",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/main/preload.bundle.js",
    "start": "npx electron .",
    "demo": "npm run build && npx electron . --demo --dist",
    "lint": "npx eslint . --ext .ts,.tsx",
    "package": "npm run build && npx electron-builder --publish never",
    "package:mac": "npm run build && npx electron-builder --mac --publish never",
    "package:win": "npm run build && npx electron-builder --win --x64 --publish never && npx electron-builder --win --arm64 --publish never",
    "package:win:nsis": "npm run build && npx electron-builder --win nsis --publish never",
    "rebuild:native": "npx electron-builder install-app-deps",
    "smoke": "npx electron . --smoke",
    "screenshots": "npm run build:renderer && node scripts/screenshot.mjs",
    "e2e": "npm run build && node scripts/e2e-demo.mjs",
    "test": "npm run build:main && node --test tests/",
    "notices": "node ../scripts/generate-third-party-notices.mjs",
    "notices:check": "node ../scripts/generate-third-party-notices.mjs --check",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.2.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.0.0",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.12",
    "eslint": "^9.39.4",
    "globals": "^14.0.0",
    "playwright-core": "^1.61.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.4.4",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.achestaro.ntnxvision",
    "productName": "NTNXVision",
    "copyright": "Copyright © 2026 Alberto Chestaro",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/main/preload.js",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@napi-rs/keyring*/**",
      "**/*.node"
    ],
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../core/dist/ntnxvision-sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "build/after-sign.js",
    "fileAssociations": [
      {
        "ext": "ntnxsnap",
        "name": "NTNXVision snapshot",
        "description": "NTNXVision snapshot file",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "NTNXVision",
      "signtoolOptions": {
        "publisherName": "Alberto Chestaro",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "msi": {
      "upgradeCode": "9EE643E8-FE25-48DF-B14C-CEA7056CF80F",
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NTNXVision",
      "menuCategory": false,
      "warningsAsErrors": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NTNXVision",
      "license": "../LICENSE"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.inherit.plist",
      "notarize": false,
      "minimumSystemVersion": "11.0",
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "writeUpdateInfo": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
